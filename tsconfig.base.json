{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@badcode/*": ["packages/*/src"],
      // Generated program interfaces (IDL + types), published by `chain build`.
      // Kept out of packages/ deliberately: they belong to the Anchor workspace,
      // which is the folder that gets copied into another project wholesale.
      "@chain/*": ["chain/*"]
    }
  }
}
