# Flow automation: persistent, logged-in Chrome profile (never commit — holds Google session)
.flow-profile/

# Flow automation: scratch screenshots from the Playwright/CDP browser workflow
# (keep the folder + its README, ignore the captured PNGs)
.flow-screenshots/*
!.flow-screenshots/README.md

# Claude Code: share project config (skills, commands, settings.json) but keep
# personal and ephemeral bits local.
.claude/worktrees/
.claude/settings.local.json

.playwright-mcp

# Solana / Anchor
chain/target/
chain/.anchor/
chain/test-ledger/

# Generated from versions.json before every docker command.
chain/docker/.env

# The container's solana config, including the local deploy keypair. Bind-mounted
# so it is inspectable and backup-able, but it is a key: never commit it.
chain/.solana/

# ./stack: pid + log files for the local dev servers
.stack/

# Cached FRED series for the ENC backtest (m2-backtest.mjs fetches it on demand)
design/research/2026-08-12-enc-tokenomics/m2sl.csv

# Flow video takes. The repo has never tracked a .mp4 and shouldn't start: a single
# scene's takes are ~155MB and git keeps every byte forever. The PROMPTS are the
# artifact (scenes/*.md); the clips are re-generatable from them, and keepers belong
# on the bucket / in the edit, not in history. Stills stay tracked — they are chain
# anchors the prompts refer to, and they are small.
docs/stories/**/storyboard/img/*.mp4
docs/stories/**/scenes/**/*.mp4

# Premiere bridge: per-machine media root + port (see design/2026-08-21-premiere-bridge-and-video-fx.md)
badcode.local.json
