# Flow automation: persistent, logged-in Chrome profile (never commit — holds Google session)
.flow-profile/

# Flow automation: scratch screenshots from the Playwright/CDP browser workflow
# (keep the folder + its README, ignore the captured PNGs)
.flow-screenshots/*
!.flow-screenshots/README.md

# Claude Code: share project config (skills, commands, settings.json) but keep
# personal and ephemeral bits local.
.claude/worktrees/
.claude/settings.local.json

.playwright-mcp

# Solana / Anchor
chain/target/
chain/.anchor/
chain/test-ledger/

# Generated from versions.json before every docker command.
chain/docker/.env

# The container's solana config, including the local deploy keypair. Bind-mounted
# so it is inspectable and backup-able, but it is a key: never commit it.
chain/.solana/

# ./stack: pid + log files for the local dev servers
.stack/
