nt-size:12px}\n.notif .nb{font-size:13.5px;color:#222;line-height:1.28;margin-top:2px}\n.pts{color:var(--mint);font-weight:700}\n/* search */\n.search{position:absolute;top:58px;left:12px;right:12px}\n.sbox{background:#fff;border-radius:22px;height:44px;display:flex;align-items:center;padding:0 14px;gap:9px;font-size:16px;color:#111;box-shadow:0 1px 3px rgba(0,0,0,.15)}\n.sbox .g{width:16px;height:16px;border:2.5px solid #666;border-radius:50%;position:relative;flex:none}\n.caret{display:inline-block;width:2px;height:19px;background:var(--ios);vertical-align:middle;margin-left:1px}\n.sugg{background:#fff;border-radius:16px;margin-top:8px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.15)}\n.sugg div{padding:12px 16px;font-size:15.5px;border-top:1px solid #eee;color:#111;display:flex;gap:10px}\n.sugg div:first-child{border-top:0}.sugg b{font-weight:700}\n.sugg i{width:14px;height:14px;border:2px solid #aaa;border-radius:50%;margin-top:2px;flex:none}\n/* badge */\n.medal{width:150px;height:150px;border-radius:50%;margin:30px auto 14px;background:conic-gradient(from 200deg,#ffb36b,#ff5a1f,#c23c0e,#ff8a3d,#ffb36b);display:grid;place-items:center;box-shadow:0 10px 30px rgba(255,90,31,.35)}\n.medal div{width:118px;height:118px;border-radius:50%;background:var(--cream);display:grid;place-items:center;font-family:'Instrument Serif',serif;font-size:54px;color:var(--ink)}\n.confetti{position:absolute;width:8px;height:14px;border-radius:2px}\n/* labels */\n.label{position:absolute;left:56px;bottom:64px;font-family:'JetBrains Mono',monospace;font-weight:700;color:#fff;font-size:44px;letter-spacing:6px;padding:10px 22px 10px 18px;background:rgba(10,10,12,.86);border-left:8px solid #d7261e}\n.label small{display:block;font-size:13px;letter-spacing:3px;color:#b9b9b9;font-weight:500;margin-bottom:2px}\n.plan{position:absolute;right:48px;top:48px;background:#fff;border:3px solid #111;padding:14px 18px;font-family:Inter;color:#111;width:360px;box-shadow:6px 6px 0 rgba(0,0,0,.35)}\n.plan .h{font-size:12px;font-weight:800;letter-spacing:2px}\n.plan .b{font-size:30px;font-weight:800;line-height:1.05;margin-top:6px}\n.plan .s{font-size:12.5px;margin-top:8px;color:#333}\n/* leaflet */\n.leaf{position:absolute;inset:0;background:#6b5a48}\n.paper{position:absolute;left:250px;top:30px;width:780px;height:820px;background:#f7f5ef;transform:rotate(-3deg);box-shadow:0 30px 60px rgba(0,0,0,.5);padding:30px 52px;font-family:'Patrick Hand',cursive;color:#111;filter:contrast(1.15) grayscale(.25)}\n.paper:before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(0,0,0,.025) 0 2px,transparent 2px 5px);pointer-events:none}\n.paper .top{font-family:Anton,Impact,sans-serif;font-size:92px;line-height:.92;letter-spacing:1px;text-align:center}\n.paper .top em{color:#d01818;font-style:normal}\n.paper .mid{font-family:'Archivo Black','Arial Black',sans-serif;font-size:52px;line-height:1;text-align:center;margin-top:20px;color:#0a3fbf}\n.paper .drop{width:120px;height:120px;margin:22px auto 6px;background:#3d8de0;border-radius:0 50% 50% 50%;transform:rotate(45deg);position:relative}\n.paper .drop:after{content:'';position:absolute;left:28px;top:28px;width:26px;height:26px;border-radius:50%;background:#fff;opacity:.7}\n.paper .foot{font-size:38px;text-align:center;margin-top:26px;line-height:1.2}\n.paper .foot u{text-decoration-thickness:3px}\n.paper .tear{position:absolute;bottom:40px;left:52px;right:52px;border-top:3px dashed #999;padding-top:10px;font-size:28px;text-align:center}\n/* ambulance light */\n.flash{position:absolute;inset:0;mix-blend-mode:normal}\n</style></head><body><div id=\"stage\"></div>\n<script>\nconst $=s=>document.querySelector(s);\nconst clamp=(x,a=0,b=1)=>Math.max(a,Math.min(b,x));\nconst ease=x=>{x=clamp(x);return x<.5?4*x*x*x:1-Math.pow(-2*x+2,3)/2};\nconst out=x=>{x=clamp(x);return 1-Math.pow(1-x,3)};\nconst op=(t,a,fade=.18)=>clamp((t-a)/fade);\n// phone placement: slides up from below at `in`, down at `outT`. Returns transform + vignette opacity.\nfunction phoneWrap(inner,t,dur,{x=880,y=60,rot=-4,dark=false,vig=.9}={}){\n  const a=out(t/.45), b=1-ease((t-(dur-.4))/.4); const k=Math.min(a,b);\n  const ty=(1-k)*760; const r=rot+(1-k)*6;\n  return `<div class=\"vig\" style=\"opacity:${(vig*k).toFixed(3)}\"></div>\n  <div class=\"phone\" style=\"left:${x}px;top:${y}px;transform:translateY(${ty}px) rotate(${r}deg)\"><div class=\"screen\">\n  <div class=\"island\"></div>\n  <div class=\"status ${dark?'dark':''}\"><span>${clock}</span><span class=\"r\"><span style=\"font-size:11px\">●●●</span><span class=\"bat\"></span></span></div>\n  ${inner}</div></div>`;\n}\nlet clock='23:47';\nconst head=`<div class=\"apphead\"><div class=\"logo\"></div><div class=\"wordmark\">enough's enough<i>.</i></div></div>`;\nfunction show(t,a,html,fade=.22){const o=op(t,a,fade);if(o<=0)return '';return `<div style=\"opacity:${o};transform:translateY(${(1-out(o))*10}px)\">${html}</div>`}\nfunction typed(t,a,str,cps=14){const n=Math.floor(clamp((t-a)*cps,0,str.length));return str.slice(0,n)}\nfunction tapAt(t,at,x,y){const d=t-at;if(d<-0.25||d>0.35)return '';const s=d<0?1-(-d/.25)*.4:1+d*1.2;const o=d<0?1-(-d/.25):1-d/.35;return `<div class=\"tap\" style=\"left:${x}px;top:${y}px;transform:translate(-50%,-50%) scale(${s});opacity:${clamp(o)}\"></div>`}\nfunction alertBox(t,a,title,sub,allowAt,{opts=null}={}){\n  if(t<a)return ''; const o=op(t,a,.2), sc=.92+.08*out(o);\n  const hit=t>=allowAt&&t<allowAt+.4;\n  const btns=opts?`<div class=\"stack\">${opts.map((s,i)=>`<div class=\"${(i===opts.length-1&&hit)?'hit':''}\" ${i===opts.length-1?'style=\"font-weight:600\"':''}>${s}</div>`).join('')}</div>`\n    :`<div class=\"btns\"><div>Don't Allow</div><div class=\"${hit?'hit':''}\">Allow</div></div>`;\n  return `<div class=\"scrim\" style=\"opacity:${o}\"></div><div class=\"alert\" style=\"opacity:${o};transform:translateY(-50%) scale(${sc})\">\n   <div class=\"ic\"></div><h3>${title}</h3><p>${sub}</p>${btns}</div>`;\n}\nconst S={};\n// ---- Scene 1: the search bar (shot 6). 5 s.\nS.search=(t)=>{clock='02:13';const q=typed(t,.5,'how to fix',9);\n const sug=t>1.9?`<div class=\"sugg\" style=\"opacity:${op(t,1.9)}\">${['patient\\'s ass','marriage','a burned leg','my life'].map((s,i)=>t>1.9+i*.28?`<div><i></i><span>how to fix <b>${s}</b></span></div>`:'').join('')}</div>`:'';\n return phoneWrap(`<div style=\"position:absolute;inset:0;background:#f1f1f4\"></div><div class=\"search\"><div class=\"sbox\"><span class=\"g\"></span><span>${q}<span class=\"caret\" style=\"opacity:${Math.floor(t*2.4)%2?0:1}\"></span></span></div>${sug}</div>`,t,5,{x:900,y:50});\n};\n// ---- Scene 9: lock screen, the ad (shot 35). 5 s.\nS.lockad=(t)=>{clock='23:47';\n const n=t>1.0?`<div class=\"notif\" style=\"top:${230+(1-out(op(t,1,.3)))*-40}px;opacity:${op(t,1,.3)}\"><div class=\"ni\"></div><div style=\"flex:1\"><div class=\"nt\">Enough's Enough <span>now</span></div><div class=\"nb\"><b>What's wrong?</b><br>Tap to talk. It's free.</div></div></div>`:'';\n return phoneWrap(`<div class=\"lock\"><div class=\"date\">Thursday</div><div class=\"time\">23:47</div>${n}</div>`,t,5,{x:860,y:60,dark:true});\n};\n// ---- Scene 10: first use (shot 36). Voice 031 starts at t=0.45 (What's wrong? / Go to bed / study / calendar). 8 s.\nS.firstuse=(t)=>{clock='23:52';\n const b=`${head}<div class=\"body\">\n ${show(t,.45,`<div class=\"bub app\">What's wrong?</div>`)}\n ${t>1.3&&t<2.2?`<div class=\"bub me dots\" style=\"background:var(--ink)\"><span style=\"background:#777\"></span><span style=\"background:#999\"></span><span style=\"background:#bbb\"></span></div>`:''}\n ${show(t,2.2,`<div class=\"bub me\">everything</div>`)}\n ${show(t,2.9,`<div class=\"bub app\">Go to bed. 10:30pm, every night.</div>`)}\n ${show(t,4.0,`<div class=\"card\"><div class=\"k\">The study</div><div class=\"t\">Sleep and next-day mood</div><div class=\"m\">Peer reviewed · 4 min read</div><div class=\"bar\"><b style=\"width:${clamp((t-4.2)*40,0,100)}%\"></b></div></div>`)}\n </div>${alertBox(t,5.4,`“Enough's Enough” Would Like to Access Your Calendar`,'So I can put bedtime in it.',7.0)}${tapAt(t,7.0,205,384)}`;\n return phoneWrap(b,t,8.2,{x:880,y:55});\n};\n// ---- Scene 11: permissions over his day (shot 43). Lines at 0.4, 4.0, 7.7, 11.5 (35-38). 13 s.\nS.perms=(t)=>{clock='08:14';\n const P=[[0.35,3.0,`“Enough's Enough” Would Like to Connect to Your Bank`,'To sort your money.',null],\n  [3.95,6.7,`Allow “Enough's Enough” to use your location?`,'To plan your runs.',['Allow Once','Allow While Using App','Always Allow']],\n  [7.65,10.3,`“Enough's Enough” Would Like to Access Your Contacts`,'To find you some mates.',null],\n  [11.45,12.05,`“Enough's Enough” Would Like to Access the Microphone`,'',null]];\n let al='';for(let i=P.length-1;i>=0;i--){const [a,hit,ti,su,opts]=P[i];const end=i<P.length-1?P[i+1][0]:99;if(t>=a&&t<end){al=alertBox(t,a,ti,su,hit,{opts})+tapAt(t,hit,opts?150:205,opts?440:(su?384:372));break}}\n const b=`${head}<div class=\"body\">${show(0,0,`<div class=\"card\"><div class=\"k\">Today</div><div class=\"t\">Run, 5k. Bed 10:30.</div><div class=\"m\">Day 12 · on track</div><div class=\"bar\"><b style=\"width:40%\"></b></div></div>`)}</div>${al}`;\n return phoneWrap(b,t,13,{x:900,y:50});\n};\n// ---- Scene 12: gym door (shot 46). Voice 044 at 0.4 for 7.4 s. 8.4 s.\nS.partner=(t)=>{clock='18:02';\n const b=`${head}<div class=\"body\">\n ${show(t,.4,`<div class=\"bub app\">People stick at it longer with a partner. There's a study.</div>`)}\n ${show(t,3.6,`<div class=\"card\"><div class=\"k\">Partner found</div><div class=\"t\">Gary, 50s</div><div class=\"m\">0.0 miles away · Logistics</div></div>`)}\n ${show(t,6.0,`<div class=\"bub app\">He's behind you.</div>`)}</div>`;\n return phoneWrap(b,t,8.4,{x:900,y:50});\n};\n// ---- Scene 13: on the stairs (shot 50). Voice 055 at 0.4 for 7.9 s. 8.8 s.\nS.sorry=(t)=>{clock='19:30';\n const items=[['Say sorry',0.5],['Offer to pay',2.0],['Then leave',3.5],['Join a local group',5.2]];\n const b=`${head}<div class=\"body\"><div style=\"font-family:'Instrument Serif';font-size:28px;color:var(--ink);padding:4px 4px 6px\">Tonight</div>\n ${items.map(([s,a])=>show(t,a,`<div class=\"card\" style=\"width:100%;display:flex;gap:10px;align-items:center;padding:13px\"><span style=\"width:20px;height:20px;border-radius:6px;border:2px solid var(--ink);display:grid;place-items:center;font-size:13px;flex:none\">${t>a+1.1?'✓':''}</span><span style=\"font-size:15px;color:var(--ink)\">${s}</span></div>`)).join('')}</div>`;\n return phoneWrap(b,t,8.8,{x:900,y:50});\n};\n// ---- Scene 14: the journal (shot 56). App prompt at 0.35, Brandon types 6.7..15.2. 15.8 s.\nS.journal=(t)=>{clock='23:58';\n const entry='Best day of my life. Jenny says the vote\\'s on the 14th. Mags has the bank details. Ted\\'s doing the leaflets.';\n const ty=typed(t,6.7,entry,12.6);\n const b=`${head}<div class=\"body\">\n ${show(t,.35,`<div class=\"bub app\">How did today make you feel?</div>`)}\n ${show(t,2.0,`<div class=\"bub app\">Who was there?</div>`)}\n ${show(t,3.6,`<div class=\"bub app\">What did they say?</div>`)}\n ${t>6.6?`<div class=\"bub me\">${ty}${t<15.3?'<span class=\"caret\" style=\"background:#fff\"></span>':''}</div>`:''}\n ${show(t,15.4,`<div style=\"align-self:center;font-size:11.5px;color:var(--mute);margin-top:4px\">Saved to your journal 🔒 Private</div>`)}</div>`;\n return phoneWrap(b,t,15.8,{x:900,y:50});\n};\n// ---- Scene 16: daily goals (shot 63). Voices 073-075 at 0.4, 5.2, 9.8. 14 s.\nS.goals=(t)=>{clock='14:06';\n const G=[[0.4,'Suggest moving the meeting to Tuesday.',50],[5.2,'Let the nice consultant finish.',75],[9.8,'Offer to handle the emails.',120]];\n const streak=99;\n const b=`<div class=\"lock\"><div class=\"date\">Saturday</div><div class=\"time\">14:06</div>\n ${G.map(([a,s,p],i)=>t>a?`<div class=\"notif\" style=\"top:${222+ (G.filter(g=>t>g[0]).length-1-i)*92}px;opacity:${op(t,a,.25)}\"><div class=\"ni\"></div><div style=\"flex:1\"><div class=\"nt\">Enough's Enough <span>now</span></div><div class=\"nb\"><b>Today's goal:</b> ${s} <span class=\"pts\">+${p}</span></div></div></div>`:'').join('')}\n <div style=\"position:absolute;bottom:40px;left:0;right:0;text-align:center;color:#fff;font-size:14px;font-weight:600;opacity:.9\">🔥 ${streak}-day streak</div></div>`;\n return phoneWrap(b,t,14,{x:900,y:50,dark:true});\n};\n// ---- Scene 16: the badge (shot 64). 7.4 s.\nS.badge=(t)=>{clock='14:31';\n const k=out(op(t,.5,.5));\n const conf=Array.from({length:18},(_,i)=>{const a=i*20,d=(t-.6)*140;if(t<.6||t>3)return '';return `<div class=\"confetti\" style=\"left:${138+Math.cos(a)*d}px;top:${210+Math.sin(a)*d+ (t-.6)*(t-.6)*60}px;background:${['#ff5a1f','#1f8a5b','#15171c','#ffb36b'][i%4]};transform:rotate(${a*3+t*300}deg);opacity:${clamp(3-t)}\"></div>`}).join('');\n const b=`${head}<div class=\"body\" style=\"text-align:center\"><div class=\"medal\" style=\"transform:scale(${.6+.4*k})\"><div>100</div></div>\n <div style=\"font-family:'Instrument Serif';font-size:30px;color:var(--ink)\">Community Champion</div>\n <div style=\"font-size:13.5px;color:var(--mute);margin-top:6px\">100 days in a row. Your group trusts you.</div>\n <div style=\"margin:16px auto 0;background:var(--ink);color:#fff;border-radius:22px;padding:11px 22px;font-weight:600;font-size:14px;display:inline-block\">Share</div></div>${conf}`;\n return phoneWrap(b,t,7.4,{x:120,y:50,rot:4});\n};\n// ---- Scene 16: goal complete, in his pocket (shot 66). 3.5 s, small, no phone.\nS.complete=(t)=>{const o=Math.min(op(t,.1,.3),1-op(t,3.0,.4));\n return `<div class=\"notif\" style=\"position:absolute;left:820px;top:40px;width:400px;opacity:${o};transform:translateY(${(1-out(op(t,.1,.4)))*-30}px)\"><div class=\"ni\"></div><div style=\"flex:1\"><div class=\"nt\">Enough's Enough <span>now</span></div><div class=\"nb\"><b>Goal complete.</b> 101 days. <span class=\"pts\">+500</span></div></div></div>`;\n};\n// ---- Scene 15: the labels on the replay. 1.25 s each, one scene per label (name passed in t's companion).\nS.label=(t,txt,sub)=>{const o=Math.min(op(t,.05,.08),1-op(t,1.15,.08));const sl=(1-out(op(t,.05,.2)))*-40;\n return `<div class=\"label\" style=\"opacity:${o};transform:translateX(${sl}px)\"><small>${sub}</small>${txt}</div>`};\n// ---- the model shot: a planning notice. 4.5 s\nS.plan=(t)=>{const o=Math.min(op(t,.2,.3),1-op(t,4.1,.3));\n return `<div class=\"plan\" style=\"opacity:${o};transform:translateY(${(1-out(op(t,.2,.4)))*-20}px)\"><div class=\"h\">PLANNING APPLICATION</div><div class=\"b\">AI DATA CENTRE</div><div class=\"s\">Hyperscale, 24/7. Land at the recreation ground. Objections by the 14th.</div></div>`};\n// ---- Ted's leaflet: opaque full frame, slow push. 5 s\nS.leaflet=(t)=>{const z=1.0+t*.025;\n return `<div class=\"leaf\"></div><div style=\"position:absolute;inset:0;transform:scale(${z})\"><div class=\"paper\">\n <div class=\"top\">STOP THE <em>A.I.</em><br>DATA CENTRE!</div><div class=\"drop\"></div>\n <div class=\"mid\">IT WILL DRINK<br>OUR TOWN DRY!!!</div>\n <div class=\"foot\">PUBLIC MEETING · <u>Thursday 7pm</u><br>St Barnabas Hall · Biscuits provided</div>\n <div class=\"tear\">Leaflet by Ted. Please do not put through number 9 again.</div></div></div>\n <div style=\"position:absolute;inset:0;background:radial-gradient(ellipse at center,rgba(0,0,0,0) 45%,rgba(0,0,0,.45) 100%)\"></div>`};\n// ---- ambulance lights: a blue/red wash pulsing, 0.9 s\nS.flash=(t)=>{const p=t/.9;const pulse=(c,ph)=>Math.max(0,Math.sin((p*3+ph)*Math.PI))**3;const env=Math.sin(clamp(p)*Math.PI);\n return `<div class=\"flash\" style=\"background:radial-gradient(ellipse at 20% 40%,rgba(30,90,255,${.75*pulse(0,0)*env}) 0%,rgba(30,90,255,0) 70%)\"></div>\n <div class=\"flash\" style=\"background:radial-gradient(ellipse at 80% 40%,rgba(255,30,40,${.6*pulse(0,.5)*env}) 0%,rgba(255,30,40,0) 70%)\"></div>\n <div class=\"flash\" style=\"background:rgba(255,255,255,${.25*Math.max(0,1-Math.abs(p-.5)*6)})\"></div>`};\nwindow.render=(name,t,a,b)=>{$('#stage').innerHTML=S[name](t,a,b);};\nwindow.fontsReady=document.fonts.ready.then(()=>true);\n</script></body></html>",
 "inputs": {
