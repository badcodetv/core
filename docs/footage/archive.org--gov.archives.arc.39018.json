use. Gen. de Gaulle speaks to the American people from New York City.","language":"English","licenseurl":"http://creativecommons.org/publicdomain/zero/1.0/","mediatype":"movies","subject":"archives.gov;public.resource.org","title":"LAST LIBERTY SHIP LAUNCHED [ETC.]","collection":["FedFlix","usgovfilms","newsandpublicaffairs"],"publicdate":"2011-03-25 06:03:26","uploader":"carl@media.org","addeddate":"2011-03-25 06:03:26","backup_location":"ia903609_11"},"server":"dn800302.us.archive.org","simplelists":{"solo_manifest":{"solo_manifest_dn800302":{"sys_changed_by":{"source":"task","task_id":"5453551010"},"sys_last_changed":"2026-06-20 09:59:40.178377"}}},"solo":true,"uniq":895651898,"workable_servers":["dn800302.us.archive.org"]}