8e2a24ce6c0937c028c93216a664aef506c775","mtime":"1547537688","size":"24307","md5":"eaa81fcdd7d16c29236bb589d65f4c30","crc32":"7f93c852","sha1":"742759301badd66587ae02eb9252ae17073bcfd5","format":"Archive BitTorrent"},{"name":"what_a_life_TNA_files.xml","source":"metadata","format":"Metadata","md5":"e54581a94597c0edca66da382b0ce787","summation":"md5"},{"name":"what_a_life_TNA_meta.xml","source":"metadata","format":"Metadata","mtime":"1547537679","size":"1165","md5":"ad58d03fb56d402e8d00af55abc46d8c","crc32":"1b3794aa","sha1":"c6145d2c9998b771462a0d70b7ff6356a00948d8"},{"name":"what_a_life_TNA_reviews.xml","source":"metadata","format":"Metadata","mtime":"1288671582","size":"2248","md5":"454ac6ba1e2f8d52344205ebf1bfa73b","crc32":"276b332c","sha1":"d4fb8f58223357efd356c375231c71ebf6e38d68"}],"files_count":86,"item_last_updated":1692427550,"item_size":1085483900,"metadata":{"identifier":"what_a_life_TNA","title":"What A Life!","mediatype":"movies","collection":["british_gov_public_films","ephemera"],"subject":"postwar austerity; Great Britain","description":"A tongue in cheek look at postwar austerity. Richard Massingham. Crown Film Unit. austere post war era.","date":"1949","hidden":"true","publicdate":"2005-10-07 10:29:34","addeddate":"2005-10-07 17:28:54","uploader":"florian@archive.org","sponsor":"Central Office of Information","director":"Michael Law","publisher":"Public Relationship Films","sound":"sound","color":"color","runtime":"11:09","credits":"Public Information Films","rights":"UK Crown Copyright","language":"english","coverage":"Great Britain","updatedate":"2005-10-07 10:32:11","updater":"nVIR","backup_location":"ia903600_10","ia_orig__runtime":"11 Minutes 9 Seconds"},"reviews":[{"reviewbody":"This, along with several of these films, is listed as being in colour when it is actually in black and white.","reviewtitle":"Black and white","reviewer":"boffy_b","reviewdate":"2008-01-19 16:36:24","createdate":"2008-01-19 16:36:24","stars":"0"},{"reviewbody":"Rather droll and depressing film until the film's final final act, where we're supposed to laugh it off I suppose? Interesting and odd premise, not too sure if it all works though. The main thing I like about this film is we get to find out the main actor's name in a lot of these british shorts in this section. His name is Richard Massingham. An excellent bio can be found at http://www.screenonline.org.uk/people/id/521707/ . Also, an interesting fact. He owned the company making these films!","reviewtitle":"What a life is right.","reviewer":"Spuzz","reviewdate":"2008-07-05 23:41:41","createdate":"2008-07-05 23:41:41","stars":"3"},{"reviewbody":"This film seems to say that the answer to doom, gloom, and pessimistic thinking brought on by the grinding deprivations of the war and then the post-war environment was to look at your misery as being absurd and laugh at it.\n\nNot a very pragmatic solution, in my opinion. \n\nI mean these guys make a suicide pact! They're at rock bottom. I don't think an absurdist point of view is going to be the magic pill for the majority of the public.\n\nThe sadness in the face of one of these fellows was so crushing that I wanted to gather him up, pet his head, and make it all better. I had an intense reaction to his expression that I don't usually have to the faces of actors on TV or film.","reviewtitle":"It sure wouldn't have cheered me up","reviewer":"jdavis_ls","reviewdate":"2008-10-26 08:03:12","createdate":"2008-10-26 08:03:12","stars":"2"}],"server":"dn600304.us.archive.org","simplelists":{"solo_manifest":{"solo_manifest_dn600304":{"sys_changed_by":{"source":"task","task_id":"5432066244"},"sys_last_changed":"2026-06-12 01:42:48.863127"}}},"solo":true,"uniq":19366828,"workable_servers":["dn600304.us.archive.org"]}