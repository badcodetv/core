{"name":"gov.archives.arc.39174_files.xml","source":"original","format":"Metadata","md5":"cb888f1709ee043642f92bc9dd2d8c11","summation":"md5"},{"name":"gov.archives.arc.39174_meta.xml","source":"original","format":"Metadata","mtime":"1463748007","size":"1692","md5":"904501153e0b443cb38d27ba7e122aa7","crc32":"a066e43b","sha1":"d76716903840738ab123ede039ed8984c80ba1f9"}],"files_count":28,"item_last_updated":1711219591,"item_size":503168622,"metadata":{"identifier":"gov.archives.arc.39174","creator":"National Archives and Records Administration","credits":"Uploaded by Public.Resource.Org","date":"1943","description":"National Archives and Records Administration - ARC 39174, LI 208-WP-91 - WAR PICTORIAL NEWS, NO. 91 - DVD Copied by Justin Grimes.  Series: Motion Picture Films from \"War Pictorial News\" Newsreels, compiled 1943 - 1945.  On the Brit. counteroffensive in Libya following Rommel's futile attempt to break through at El Alamein. Brit. tanks cross a desert area; wounded tankmen are given first aid and placed on ambulances. U.S. B-24's bomb Tripoli as Brit. armor advances. Brit. planes strafe retreating Ger. units and Ger. ships attempting to land reinforcements and supplies. Ger. POW's are marched to the rear. Shows Ital. POW's and Arab natives as Brit. forces enter Tripoli. Gen. Montgomery receives the surrender of the city from its Ital. mayor. Brit. tanks are massed in the square, the Brit. flag is raised, and Gen. Montgomery rides in a motorcade through the city.","language":"English","licenseurl":"http://creativecommons.org/publicdomain/zero/1.0/","mediatype":"movies","subject":"archives.gov;public.resource.org","title":"WAR PICTORIAL NEWS, NO. 91","collection":["FedFlix","usgovfilms","newsandpublicaffairs"],"publicdate":"2011-03-25 13:33:39","uploader":"carl@media.org","addeddate":"2011-03-25 13:33:39","backup_location":"ia903609_12"},"server":"dn800209.us.archive.org","simplelists":{"solo_manifest":{"solo_manifest_dn800209":{"sys_changed_by":{"source":"