a62028","mtime":"1577169395","size":"30444","md5":"b41474733507ba4de81592e0b0787f4f","crc32":"1b805dc7","sha1":"274a52d9fe6c57f2516909b746972cbdf2b933fa","format":"Archive BitTorrent"},{"name":"gov.archives.arc.13595_files.xml","source":"original","format":"Metadata","md5":"2ce442c5a912fab279372ad16642ccf1","summation":"md5"},{"name":"gov.archives.arc.13595_meta.xml","source":"original","format":"Metadata","mtime":"1577169381","size":"1738","md5":"73688a9749b8acb0bbe67788be867132","crc32":"d84274bc","sha1":"75b478b4d8c3e38c21353f8a292758a462a90c25"},{"name":"gov.archives.arc.13595_reviews.xml","source":"original","format":"Metadata","mtime":"1293420828","size":"1151","md5":"ee92573860261189418419b4a491a591","crc32":"9c83427","sha1":"ee6ba7e1ecd6ed710d441e2282dfea1e49a07f3c"}],"files_count":36,"item_last_updated":1705806169,"item_size":1478348779,"metadata":{"identifier":"gov.archives.arc.13595","creator":"National Archives and Records Administration","credits":"Uploaded by Public.Resource.Org","date":"1937","description":"National Archives and Records Administration<br /><br />The Plow That Broke the Plains<br /><br /> Department of Agriculture. Farm Security Administration. Information Division. (ca. 1937 - ca. 1942)<br /><br />ARC Identifier 13595 / Local Identifier 96.2. The film presents the social and economic history of the Great Plains -- from the time of the settlement of the prairies, through the World War I boom, to the years of depression and drought. The first part of the film shows cattle as they grazed on grasslands, and homesteaders who hurried onto the plains and grew large wheat crops. The second part depicts the postwar decline of the wheat market, which resulted in overproduction. Footage shows farm equipment used, then abandoned. The third part shows a dust storm as it rendered a farm useless. Subsequent scenes show farmers as they left their homes and headed west.","language":"English","licenseurl":"http://creativecommons.org/licenses/publicdomain/","mediatype":"movies","subject":"archives.gov;public.resource.org","title":"The Plow That Broke the Plains","collection":["FedFlix","usgovfilms","newsandpublicaffairs"],"uploader":"carl@media.org","publicdate":"2016-03-22 12:03:47","backup_location":"ia906102_20","addeddate":"2016-03-22 12:03:47"},"reviews":[{"reviewbody":"It was not a movie about how top resolve the problem nor to give you a sense of warm fuzziness.   The movie was made to  show what the dusters had to deal with and,  how that problem began.  \nIt was made to  show the  utter hoplessness of the problem at hand.  It was a U.S. propaganda film made with the purpose of bringing the situations attention to the  U.S. Population because most of America did not care what was happening to the dusters.\nIt was meant to help F.D.R. help establish his policies and save the U.S. from this problem.  The movie was made for  that spcecific purpose and, it served  well.  \nIf you are looking for resolve search FDR's policy in regard to the dust bowl.","reviewtitle":"It was meant to be a movie of resolve","reviewer":"armychuck","reviewdate":"2010-01-26 14:09:27","createdate":"2010-01-26 14:09:27","stars":"5"}],"server":"dn801203.us.archive.org","simplelists":{"solo_manifest":{"solo_manifest_dn801203":{"sys_changed_by":{"source":"task","task_id":"5465035565"},"sys_last_changed":"2026-06-25 12:28:46.266384"}}},"solo":true,"uniq":33822316,"workable_servers":["dn801203.us.archive.org"]}