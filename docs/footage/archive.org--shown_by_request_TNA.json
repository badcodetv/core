41a85bdf59778b41d52fbf827188","crc32":"2170f365","sha1":"d78f47d4ec0ad6f633e785209bb9b96b355d3e46"},{"name":"shown_by_request_TNA_reviews.xml","source":"metadata","format":"Metadata","mtime":"1209860514","size":"990","md5":"cdda33bfdb602ea826ffa272379eef21","crc32":"18fad3cd","sha1":"4ff7ca5baa009e31422c8783e8e36218b90882c4"}],"files_count":74,"item_last_updated":1710037904,"item_size":1769225573,"metadata":{"identifier":"shown_by_request_TNA","title":"Shown by Request","mediatype":"movies","collection":["british_gov_public_films","ephemera"],"subject":"Central Film Library; education","description":"The work of mobile film units and the Central Film Library in distributing films of social and educational value all over the country","date":"1947","hidden":"true","publicdate":"2005-10-07 12:28:24","addeddate":"2005-10-07 19:26:09","uploader":"florian@archive.org","sponsor":"Central Office of Information","director":"Colin Dean","publisher":"Crown Film Unit","sound":"sound","color":"color","runtime":"18:15","credits":"Public Information Films","rights":"UK Crown Copyright","language":"english","coverage":"Great Britain","updatedate":"2005-10-07 12:30:12","updater":"nVIR","backup_location":"ia903600_10","ia_orig__runtime":"18 Minutes 15 Seconds"},"reviews":[{"reviewbody":"Terribly odd film about how the movie got to where you are watching it from, fellow British Citizen! This is actually a quite interesting glimpse about film distribution in Britain in the 40's, You know, when a crowd of brits would jam a movie theater to see a doc film about migrant workers. I guess Brief Encounter was sold out. Anyways, dour brits catalog your film for you. Love the guy with singular stamps, who seems to, well, use singular stamps all day. Noone looks like they're having a good time, which pretty much sums up 1950's Britain I guess. ","reviewtitle":"We Are Amused.","reviewer":"Spuzz","reviewdate":"2008-05-04 00:21:51","createdate":"2008-05-04 00:21:51","stars":"3"}],"server":"dn601207.us.archive.org","simplelists":{"solo_manifest":{"solo_manifest_dn601207":{"sys_changed_by":{"source":"task","task_id":"5444447555"},"sys_last_changed":"2026-06-16 20:52:08.187208"}}},"solo":true,"uniq":788652359,"workable_servers":["dn601207.us.archive.org"]}