h":"320"},{"name":"into_the_blue_TNA_56K.wmv","source":"original","md5":"954f3fbe3602c287ee21e9aa2a842ff3","mtime":"1129586459","size":"3908903","crc32":"445bbecd","sha1":"d1cf81fbe474c9e0d8112a953dbf387312ddba6e","format":"Windows Media","length":"627.15","height":"288","width":"352"},{"name":"into_the_blue_TNA_archive.torrent","source":"metadata","btih":"4f22a97521acd997f90a6d61782c2c56aa0ab4ae","mtime":"1547527023","size":"34783","md5":"3d7e37dfe1d1a81546582b234d6184bf","crc32":"9da2e9d5","sha1":"f4931732558bd8caf8e1dc8e053ce4ad4d194301","format":"Archive BitTorrent"},{"name":"into_the_blue_TNA_files.xml","source":"metadata","format":"Metadata","md5":"1b5bb4aa7794d4304b49315b159815a0","summation":"md5"},{"name":"into_the_blue_TNA_meta.xml","source":"metadata","format":"Metadata","mtime":"1547527012","size":"1257","md5":"c261da1ff494744540ea8ea172eae17a","crc32":"3a794c3e","sha1":"7a84ac59f87f3471489d09fde4c596198b6c2310"},{"name":"into_the_blue_TNA_reviews.xml","source":"metadata","format":"Metadata","mtime":"1389779418","size":"1904","md5":"bf98df09e396e7a8163b25dc952f45c2","crc32":"865395fa","sha1":"fcba0a6d30653e121ae0bce698a595e04376c7bf"}],"files_count":32,"item_last_updated":1624671477,"item_size":844883596,"metadata":{"identifier":"into_the_blue_TNA","title":"Into the Blue","mediatype":"movies","collection":["british_gov_public_films","ephemera"],"subject":"civil airline; Britain; jet-aircraft","description":"How Britain developed her civil airlines since the war. commercial jet-aircraft. De Havilland Comet. Bristol Brabazon. air travel","date":"1950","hidden":"true","publicdate":"2005-10-07 09:18:34","addeddate":"2005-10-07 15:57:40","uploader":"florian@archive.org","updater":["nVIR","nVIR"],"updatedate":["2005-10-07 09:35:02","2005-10-07 09:57:49"],"sponsor":"Central Office of Information for Economic Information Unit","publisher":"Crown Film Unit","sound":"sound","color":"color","runtime":"10:27","credits":"Public Information Films","rights":"UK Crown Copyright","language":"English","coverage":"Great Britain","backup_location":"ia903600_10","ia_orig__runtime":"10 Minutes 27 Seconds"},"reviews":[{"reviewbody":"The film touts the development of British civilian air service after World War II.  The film documents how British Airways was once two separate services: British European Airways, which serviced just European continent, and British Overseas Airways Corp., which covered everywhere else.  As with many films from the early days of international air travel, the luxury of the trip is emphasized in this film.   Passengers are shown have a selection of alcohol in the terminal before departure, for example.  The film also has examples of period aircraft and airlines, such as Swiss Air, SAS, Iceland Airways, and TWA.  Early British jets, cargo planes, and amphibious craft round out the imagery.  Otherwise, mildly interesting from a historical viewpoint and standard issue bombastic narrator.","reviewtitle":"Wild Blue Yonder","reviewer":"Wilford B. Wolf","reviewdate":"2007-02-22 00:19:01","createdate":"2007-02-22 00:19:01","stars":"3"},{"reviewbody":"Next time my head is being ground into the sticky lino on the floor of a Ryanair plane as 50 people stampede over me, I\u2019ll think of how\u2026\u2026\u2026of how it used to be:\n\nPeople who could speak English even better than the Queen\n\nFlashing airscrews\n\nA toothbrush and a powder puff\u2026..\n\nFlying boats\n\nDealing with Colonial affairs\n\nBreakfast in bed at 15,000 feet\n\nMen named \u201cWhitney Straight\u201d\n\nBottle tops for lunch\n","reviewtitle":"Wonderful","reviewer":"Rooftopjump","reviewdate":"2014-01-15 09:50:17","createdate":"2014-01-15 09:50:17","stars":"5"}],"server":"dn800309.us.archive.org","simplelists":{"solo_manifest":{"solo_manifest_dn800309":{"sys_changed_by":{"source":"task","task_id":"5439143373"},"sys_last_changed":"2026-06-14 20:24:47.766894"}}},"solo":true,"uniq":425220241,"workable_servers":["dn800309.us.archive.org"]}