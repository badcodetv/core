[
 {
  "id": "P1.01",
  "part": "P1",
  "text": "Dunkirk... nineteen forty.",
  "words": 3,
  "scene": "01",
  "clock": 3,
  "match": 1.0,
  "start": 3.0,
  "end": 6.0
 },
 {
  "id": "P1.02",
  "part": "P1",
  "text": "More than three hundred and thirty-eight thousand British and Allied troops evacuated from the beaches and harbour.",
  "words": 17,
  "scene": "01",
  "clock": 6,
  "match": 0.78,
  "start": 6.0,
  "end": 12.0
 },
 {
  "id": "P1.03",
  "part": "P1",
  "text": "Naval ships. Merchant crews. Little boats.",
  "words": 6,
  "scene": "01",
  "clock": 12,
  "match": 1.0,
  "start": 12.0,
  "end": 17.0
 },
 {
  "id": "P1.04",
  "part": "P1",
  "text": "People helping people get out alive.",
  "words": 6,
  "scene": "01",
  "clock": 17,
  "match": 1.0,
  "start": 17.0,
  "end": 21.0
 },
 {
  "id": "P1.05",
  "part": "P1",
  "text": "A defeat... and an extraordinary rescue.",
  "words": 6,
  "scene": "01",
  "clock": 21,
  "match": 1.0,
  "start": 21.0,
  "end": 25.0
 },
 {
  "id": "P1.06",
  "part": "P1",
  "text": "Britain remembers the getting-home part.",
  "words": 5,
  "scene": "01",
  "clock": 25,
  "match": 1.0,
  "start": 25.0,
  "end": 30.0
 },
 {
  "id": "P1.07",
  "part": "P1",
  "text": "This is about what came after.",
  "words": 6,
  "scene": "01",
  "clock": 30,
  "match": 1.0,
  "start": 30.0,
  "end": 35.0
 },
 {
  "id": "P1.08",
  "part": "P1",
  "text": "When the war ends, there will still be homes to rebuild, work to find, people getting ill.",
  "words": 17,
  "scene": "02",
  "clock": 35,
  "match": 0.77,
  "start": 35.0,
  "end": 44.0
 },
 {
  "id": "P1.09",
  "part": "P1",
  "text": "Britain will owe about two and a half times what it earns in a year.",
  "words": 15,
  "scene": "02",
  "clock": 44,
  "match": 1.0,
  "start": 44.0,
  "end": 50.0
 },
 {
  "id": "P1.10",
  "part": "P1",
  "text": "In nineteen forty-eight it will open the NHS anyway.",
  "words": 9,
  "scene": "02",
  "clock": 50,
  "match": 1.0,
  "start": 50.0,
  "end": 55.0
 },
 {
  "id": "P1.11",
  "part": "P1",
  "text": "Almost seventy years later, a nurse will ask about her pay... and hear that there is no magic money tree.",
  "words": 20,
  "scene": "02",
  "clock": 55,
  "match": 1.0,
  "start": 55.0,
  "end": 63.0
 },
 {
  "id": "P1.12",
  "part": "P1",
  "text": "Both of those things happened in the same country.",
  "words": 9,
  "scene": "02",
  "clock": 63,
  "match": 1.0,
  "start": 63.0,
  "end": 67.0
 },
 {
  "id": "P1.13",
  "part": "P1",
  "text": "One economist helped explain the first.",
  "words": 6,
  "scene": "02",
  "clock": 67,
  "match": 1.0,
  "start": 67.0,
  "end": 70.23
 },
 {
  "id": "P1.14",
  "part": "P1",
  "text": "He did not live to see it.",
  "words": 7,
  "scene": "02",
  "clock": 67,
  "match": 1.0,
  "start": 70.23,
  "end": 74.0
 },
 {
  "id": "P1.15",
  "part": "P1",
  "text": "John Maynard Keynes.",
  "words": 3,
  "scene": "02",
  "clock": 74,
  "match": 1.0,
  "start": 74.0,
  "end": 78.0
 },
 {
  "id": "P1.16",
  "part": "P1",
  "text": "This is the future he never saw.",
  "words": 7,
  "scene": "02",
  "clock": 78,
  "match": 1.0,
  "start": 78.0,
  "end": 90.0
 },
 {
  "id": "P2.01",
  "part": "P2",
  "text": "Germany... nineteen twenty-three.",
  "words": 3,
  "scene": "02a",
  "clock": 90,
  "match": 1.0,
  "start": 90.0,
  "end": 91.29
 },
 {
  "id": "P2.02",
  "part": "P2",
  "text": "Seventeen years before Dunkirk.",
  "words": 4,
  "scene": "02a",
  "clock": 90,
  "match": 1.0,
  "start": 91.29,
  "end": 93.0
 },
 {
  "id": "P2.03",
  "part": "P2",
  "text": "War debts, reparations and a political crisis have strained the state.",
  "words": 11,
  "scene": "02a",
  "clock": 93,
  "match": 1.0,
  "start": 93.0,
  "end": 99.0
 },
 {
  "id": "P2.04",
  "part": "P2",
  "text": "It borrows from its central bank, which creates the money.",
  "words": 10,
  "scene": "02a",
  "clock": 99,
  "match": 1.0,
  "start": 99.0,
  "end": 104.0
 },
 {
  "id": "P2.05",
  "part": "P2",
  "text": "Then the Ruhr is occupied, and production stalls.",
  "words": 8,
  "scene": "02a",
  "clock": 104,
  "match": 1.0,
  "start": 104.0,
  "end": 111.0
 },
 {
  "id": "P2.06",
  "part": "P2",
  "text": "The state pays the workers anyway.",
  "words": 6,
  "scene": "02a",
  "clock": 111,
  "match": 1.0,
  "start": 111.0,
  "end": 114.6
 },
 {
  "id": "P2.07",
  "part": "P2",
  "text": "More notes. Fewer goods.",
  "words": 4,
  "scene": "02a",
  "clock": 111,
  "match": 1.0,
  "start": 114.6,
  "end": 117.0
 },
 {
  "id": "P2.08",
  "part": "P2",
  "text": "In some places people are paid daily, and hurry to spend it before the prices change.",
  "words": 16,
  "scene": "02a",
  "clock": 117,
  "match": 1.0,
  "start": 117.0,
  "end": 124.53
 },
 {
  "id": "P2.09",
  "part": "P2",
  "text": "The currency collapses.",
  "words": 3,
  "scene": "02a",
  "clock": 125,
  "match": 1.0,
  "start": 125.0,
  "end": 128.0
 },
 {
  "id": "P2.10",
  "part": "P2",
  "text": "That is one thing you can do with a money tree.",
  "words": 11,
  "scene": "02a",
  "clock": 128,
  "match": 1.0,
  "start": 128.0,
  "end": 131.67
 },
 {
  "id": "P2.11",
  "part": "P2",
  "text": "You can shake it.",
  "words": 4,
  "scene": "02a",
  "clock": 128,
  "match": 1.0,
  "start": 131.67,
  "end": 133.0
 },
 {
  "id": "P2.12",
  "part": "P2",
  "text": "The money falls.",
  "words": 3,
  "scene": "02a",
  "clock": 133,
  "match": 1.0,
  "start": 133.0,
  "end": 135.1
 },
 {
  "id": "P2.13",
  "part": "P2",
  "text": "There is nothing underneath it to buy.",
  "words": 7,
  "scene": "02a",
  "clock": 133,
  "match": 1.0,
  "start": 135.1,
  "end": 140.0
 },
 {
  "id": "P2.14",
  "part": "P2",
  "text": "The early nineteen thirties bring the opposite disaster.",
  "words": 8,
  "scene": "03",
  "clock": 140,
  "match": 1.0,
  "start": 140.0,
  "end": 146.5
 },
 {
  "id": "P2.15",
  "part": "P2",
  "text": "Falling prices. Closed works. Queues for a job.",
  "words": 8,
  "scene": "03",
  "clock": 140,
  "match": 1.0,
  "start": 146.5,
  "end": 153.0
 },
 {
  "id": "P2.16",
  "part": "P2",
  "text": "Picture it small.",
  "words": 3,
  "scene": "03",
  "clock": 153,
  "match": 1.0,
  "start": 153.0,
  "end": 157.0
 },
 {
  "id": "P2.17",
  "part": "P2",
  "text": "An unemployed builder. A family needing a house.",
  "words": 8,
  "scene": "03",
  "clock": 157,
  "match": 0.69,
  "start": 157.0,
  "end": 160.0
 },
 {
  "id": "P2.18",
  "part": "P2",
  "text": "The materials, for this example, in the yard.",
  "words": 8,
  "scene": "03",
  "clock": 160,
  "match": 1.0,
  "start": 160.0,
  "end": 164.0
 },
 {
  "id": "P2.19",
  "part": "P2",
  "text": "The builder can build. The family needs a home.",
  "words": 9,
  "scene": "03",
  "clock": 164,
  "match": 1.0,
  "start": 164.0,
  "end": 168.91
 },
 {
  "id": "P2.20",
  "part": "P2",
  "text": "Nothing happens.",
  "words": 2,
  "scene": "03",
  "clock": 164,
  "match": 1.0,
  "start": 168.91,
  "end": 170.0
 },
 {
  "id": "P2.21",
  "part": "P2",
  "text": "Need isn't a paying order.",
  "words": 5,
  "scene": "03",
  "clock": 170,
  "match": 1.0,
  "start": 170.0,
  "end": 173.0
 },
 {
  "id": "P2.22",
  "part": "P2",
  "text": "That is the second thing you can do.",
  "words": 8,
  "scene": "03",
  "clock": 173,
  "match": 1.0,
  "start": 173.0,
  "end": 175.67
 },
 {
  "id": "P2.23",
  "part": "P2",
  "text": "You can starve it.",
  "words": 4,
  "scene": "03",
  "clock": 173,
  "match": 1.0,
  "start": 175.67,
  "end": 177.0
 },
 {
  "id": "P2.24",
  "part": "P2",
  "text": "Keynes challenged the idea that an economy would reliably put everyone to work by itself.",
  "words": 15,
  "scene": "03",
  "clock": 177,
  "match": 1.0,
  "start": 177.0,
  "end": 185.0
 },
 {
  "id": "P2.25",
  "part": "P2",
  "text": "When private spending falls short, government can commission useful work.",
  "words": 10,
  "scene": "03",
  "clock": 185,
  "match": 1.0,
  "start": 185.0,
  "end": 190.0
 },
 {
  "id": "P2.26",
  "part": "P2",
  "text": "The builder hasn't suddenly acquired moral character.",
  "words": 7,
  "scene": "03",
  "clock": 190,
  "match": 1.0,
  "start": 190.0,
  "end": 193.18
 },
 {
  "id": "P2.27",
  "part": "P2",
  "text": "He's acquired a customer.",
  "words": 4,
  "scene": "03",
  "clock": 190,
  "match": 1.0,
  "start": 193.18,
  "end": 195.0
 },
 {
  "id": "P3.01",
  "part": "P3",
  "text": "That doesn't mean ordering a million houses makes them appear.",
  "words": 10,
  "scene": "04",
  "clock": 195,
  "match": 1.0,
  "start": 195.0,
  "end": 200.0
 },
 {
  "id": "P3.02",
  "part": "P3",
  "text": "If the bricks are missing, make bricks.",
  "words": 7,
  "scene": "04",
  "clock": 200,
  "match": 1.0,
  "start": 200.0,
  "end": 204.0
 },
 {
  "id": "P3.03",
  "part": "P3",
  "text": "If the skills are missing, train people.",
  "words": 7,
  "scene": "04",
  "clock": 204,
  "match": 1.0,
  "start": 204.0,
  "end": 207.0
 },
 {
  "id": "P3.04",
  "part": "P3",
  "text": "Those take time too.",
  "words": 4,
  "scene": "04",
  "clock": 207,
  "match": 1.0,
  "start": 207.0,
  "end": 211.0
 },
 {
  "id": "P3.05",
  "part": "P3",
  "text": "And if everyone is already busy, more money doesn't build more homes.",
  "words": 12,
  "scene": "04",
  "clock": 211,
  "match": 1.0,
  "start": 211.0,
  "end": 215.91
 },
 {
  "id": "P3.06",
  "part": "P3",
  "text": "It bids up the price of the ones there are.",
  "words": 10,
  "scene": "04",
  "clock": 211,
  "match": 1.0,
  "start": 215.91,
  "end": 220.0
 },
 {
  "id": "P3.07",
  "part": "P3",
  "text": "Keynes named that limit himself.",
  "words": 5,
  "scene": "04",
  "clock": 220,
  "match": 1.0,
  "start": 220.0,
  "end": 223.0
 },
 {
  "id": "P3.08",
  "part": "P3",
  "text": "Demand beyond what the country can physically supply is, he said, \"the proper meaning of inflation\".",
  "words": 16,
  "scene": "04",
  "clock": 223,
  "match": 0.99,
  "start": 223.0,
  "end": 232.0
 },
 {
  "id": "P3.09",
  "part": "P3",
  "text": "Inside that limit...",
  "words": 3,
  "scene": "04",
  "clock": 232,
  "match": 1.0,
  "start": 232.0,
  "end": 233.26
 },
 {
  "id": "P3.10",
  "part": "P3",
  "text": "\"Anything we can actually do we can afford.\"",
  "words": 8,
  "scene": "04",
  "clock": 232,
  "match": 1.0,
  "start": 233.26,
  "end": 236.63
 },
 {
  "id": "P3.11",
  "part": "P3",
  "text": "\"Actually\" is carrying quite a lot of the sentence.",
  "words": 9,
  "scene": "04",
  "clock": 240,
  "match": 0.98,
  "start": 240.0,
  "end": 245.0
 },
 {
  "id": "P3.12",
  "part": "P3",
  "text": "That is the third thing you can do.",
  "words": 8,
  "scene": "04",
  "clock": 245,
  "match": 1.0,
  "start": 245.0,
  "end": 248.33
 },
 {
  "id": "P3.13",
  "part": "P3",
  "text": "You can plant it.",
  "words": 4,
  "scene": "04",
  "clock": 245,
  "match": 1.0,
  "start": 248.33,
  "end": 250.0
 },
 {
  "id": "P3.14",
  "part": "P3",
  "text": "In work that can actually be done.",
  "words": 7,
  "scene": "04",
  "clock": 250,
  "match": 1.0,
  "start": 250.0,
  "end": 260.0
 },
 {
  "id": "P4.01",
  "part": "P4",
  "text": "Britain didn't fight the war by discovering a cupboard of free money.",
  "words": 12,
  "scene": "05",
  "clock": 260,
  "match": 1.0,
  "start": 260.0,
  "end": 265.0
 },
 {
  "id": "P4.02",
  "part": "P4",
  "text": "It taxed. Borrowed. Directed production. Rationed goods.",
  "words": 7,
  "scene": "05",
  "clock": 265,
  "match": 1.0,
  "start": 265.0,
  "end": 271.0
 },
 {
  "id": "P4.03",
  "part": "P4",
  "text": "Relied on overseas supplies and support.",
  "words": 6,
  "scene": "05",
  "clock": 271,
  "match": 1.0,
  "start": 271.0,
  "end": 274.0
 },
 {
  "id": "P4.04",
  "part": "P4",
  "text": "People paid in work, in foregone comforts, and in losses no budget can measure.",
  "words": 14,
  "scene": "05",
  "clock": 274,
  "match": 1.0,
  "start": 274.0,
  "end": 283.0
 },
 {
  "id": "P4.05",
  "part": "P4",
  "text": "Keynes worked on the finances.",
  "words": 5,
  "scene": "05",
  "clock": 283,
  "match": 1.0,
  "start": 283.0,
  "end": 285.25
 },
 {
  "id": "P4.06",
  "part": "P4",
  "text": "He proposed taxes and deferred pay to hold spending down while production went to war.",
  "words": 15,
  "scene": "05",
  "clock": 283,
  "match": 1.0,
  "start": 285.25,
  "end": 292.0
 },
 {
  "id": "P4.07",
  "part": "P4",
  "text": "Inflation was the thing he was trying to prevent.",
  "words": 9,
  "scene": "05",
  "clock": 292,
  "match": 1.0,
  "start": 292.0,
  "end": 296.0
 },
 {
  "id": "P4.08",
  "part": "P4",
  "text": "An American army film of the time put Britain's tax rates on the screen.",
  "words": 14,
  "scene": "05",
  "clock": 296,
  "match": 1.0,
  "start": 296.0,
  "end": 303.3
 },
 {
  "id": "P4.09",
  "part": "P4",
  "text": "The highest went to the people with the most.",
  "words": 9,
  "scene": "05",
  "clock": 296,
  "match": 1.0,
  "start": 303.3,
  "end": 308.0
 },
 {
  "id": "P4.10",
  "part": "P4",
  "text": "Winning would leave another job...",
  "words": 5,
  "scene": "05",
  "clock": 308,
  "match": 1.0,
  "start": 308.0,
  "end": 312.38
 },
 {
  "id": "P4.11",
  "part": "P4",
  "text": "organising the peace.",
  "words": 3,
  "scene": "05",
  "clock": 308,
  "match": 1.0,
  "start": 312.38,
  "end": 315.0
 },
 {
  "id": "P4.12",
  "part": "P4",
  "text": "Before victory, Churchill's coalition accepted responsibility for maintaining \"a high and stable level of employment\" after the war.",
  "words": 18,
  "scene": "06",
  "clock": 315,
  "match": 0.99,
  "start": 315.0,
  "end": 324.0
 },
 {
  "id": "P4.13",
  "part": "P4",
  "text": "Not just finding people something to do in uniform.",
  "words": 9,
  "scene": "06",
  "clock": 324,
  "match": 1.0,
  "start": 324.0,
  "end": 328.2
 },
 {
  "id": "P4.14",
  "part": "P4",
  "text": "Making civilian work a public responsibility.",
  "words": 6,
  "scene": "06",
  "clock": 324,
  "match": 1.0,
  "start": 328.2,
  "end": 331.0
 },
 {
  "id": "P4.15",
  "part": "P4",
  "text": "Beveridge's proposals, and plans for a national health service, were part of the argument about the peace too.",
  "words": 18,
  "scene": "06",
  "clock": 331,
  "match": 1.0,
  "start": 331.0,
  "end": 339.0
 },
 {
  "id": "P4.16",
  "part": "P4",
  "text": "Keynes wasn't building this future alone.",
  "words": 6,
  "scene": "06",
  "clock": 339,
  "match": 1.0,
  "start": 339.0,
  "end": 344.0
 },
 {
  "id": "P4.17",
  "part": "P4",
  "text": "And a promise on paper still needed a government to carry it out.",
  "words": 13,
  "scene": "06",
  "clock": 344,
  "match": 1.0,
  "start": 344.0,
  "end": 355.0
 },
 {
  "id": "P5.01",
  "part": "P5",
  "text": "In nineteen forty-five, Britain wins.",
  "words": 5,
  "scene": "07",
  "clock": 355,
  "match": 1.0,
  "start": 355.0,
  "end": 360.0
 },
 {
  "id": "P5.02",
  "part": "P5",
  "text": "Voters elect Attlee's Labour government.",
  "words": 5,
  "scene": "07",
  "clock": 360,
  "match": 1.0,
  "start": 360.0,
  "end": 364.0
 },
 {
  "id": "P5.03",
  "part": "P5",
  "text": "The celebration does not come with a roof.",
  "words": 8,
  "scene": "07",
  "clock": 364,
  "match": 1.0,
  "start": 364.0,
  "end": 368.0
 },
 {
  "id": "P5.04",
  "part": "P5",
  "text": "Debt is enormous. Supplies are short. Rationing continues.",
  "words": 8,
  "scene": "07",
  "clock": 368,
  "match": 1.0,
  "start": 368.0,
  "end": 375.0
 },
 {
  "id": "P5.05",
  "part": "P5",
  "text": "But the war's end releases people and production for civilian work.",
  "words": 11,
  "scene": "07",
  "clock": 375,
  "match": 1.0,
  "start": 375.0,
  "end": 379.0
 },
 {
  "id": "P5.06",
  "part": "P5",
  "text": "Taxes and borrowing remain part of the answer...",
  "words": 8,
  "scene": "07",
  "clock": 379,
  "match": 1.0,
  "start": 379.0,
  "end": 381.8
 },
 {
  "id": "P5.07",
  "part": "P5",
  "text": "so do external finance, and the difficult business of paying for imports.",
  "words": 12,
  "scene": "07",
  "clock": 379,
  "match": 1.0,
  "start": 381.8,
  "end": 386.0
 },
 {
  "id": "P5.08",
  "part": "P5",
  "text": "Keynes negotiates an American loan, then defends it in Parliament.",
  "words": 10,
  "scene": "07",
  "clock": 386,
  "match": 1.0,
  "start": 386.0,
  "end": 391.0
 },
 {
  "id": "P5.09",
  "part": "P5",
  "text": "Still finding time to tell a fellow peer: \"I have never heard statistics so funny.\"",
  "words": 15,
  "scene": "07",
  "clock": 391,
  "match": 0.98,
  "start": 391.0,
  "end": 396.0
 },
 {
  "id": "P5.10",
  "part": "P5",
  "text": "The country doesn't wait to clear its entire debt before rebuilding.",
  "words": 11,
  "scene": "07",
  "clock": 396,
  "match": 1.0,
  "start": 396.0,
  "end": 401.21
 },
 {
  "id": "P5.11",
  "part": "P5",
  "text": "Debt is a burden.",
  "words": 4,
  "scene": "07",
  "clock": 396,
  "match": 1.0,
  "start": 401.21,
  "end": 403.11
 },
 {
  "id": "P5.12",
  "part": "P5",
  "text": "It isn't a veto.",
  "words": 4,
  "scene": "07",
  "clock": 396,
  "match": 1.0,
  "start": 403.11,
  "end": 405.0
 },
 {
  "id": "P5.13",
  "part": "P5",
  "text": "Keynes died on the twenty-first of April, nineteen forty-six.",
  "words": 9,
  "scene": "08",
  "clock": 405,
  "match": 0.71,
  "start": 405.0,
  "end": 410.0
 },
 {
  "id": "P5.14",
  "part": "P5",
  "text": "The NHS would open more than two years later.",
  "words": 9,
  "scene": "08",
  "clock": 410,
  "match": 1.0,
  "start": 410.0,
  "end": 414.0
 },
 {
  "id": "P5.15",
  "part": "P5",
  "text": "He had seen victory.",
  "words": 4,
  "scene": "08",
  "clock": 410,
  "match": 1.0,
  "start": 414.0,
  "end": 415.78
 },
 {
  "id": "P5.16",
  "part": "P5",
  "text": "He would not see this.",
  "words": 5,
  "scene": "08",
  "clock": 410,
  "match": 1.0,
  "start": 415.78,
  "end": 418.0
 },
 {
  "id": "P5.17",
  "part": "P5",
  "text": "We don't know what he would have made of everything that followed.",
  "words": 12,
  "scene": "08",
  "clock": 418,
  "match": 1.0,
  "start": 418.0,
  "end": 425.58
 },
 {
  "id": "P5.18",
  "part": "P5",
  "text": "Other people had the work to do.",
  "words": 7,
  "scene": "08",
  "clock": 418,
  "match": 1.0,
  "start": 425.58,
  "end": 430.0
 },
 {
  "id": "P6.01",
  "part": "P6",
  "text": "Attlee's government, with Aneurin Bevan as Health Minister, established the NHS.",
  "words": 11,
  "scene": "09",
  "clock": 430,
  "match": 1.0,
  "start": 430.0,
  "end": 436.0
 },
 {
  "id": "P6.02",
  "part": "P6",
  "text": "It took legislation, negotiation, and people turning up to work.",
  "words": 10,
  "scene": "09",
  "clock": 436,
  "match": 1.0,
  "start": 436.0,
  "end": 441.0
 },
 {
  "id": "P6.03",
  "part": "P6",
  "text": "On the fifth of July, nineteen forty-eight, existing hospitals and services became part of a new settlement...",
  "words": 17,
  "scene": "09",
  "clock": 441,
  "match": 0.92,
  "start": 441.0,
  "end": 446.0
 },
 {
  "id": "P6.04",
  "part": "P6",
  "text": "care available to everyone, free at the point of use.",
  "words": 10,
  "scene": "09",
  "clock": 446,
  "match": 1.0,
  "start": 446.0,
  "end": 454.0
 },
 {
  "id": "P6.05",
  "part": "P6",
  "text": "Not free to provide.",
  "words": 4,
  "scene": "09",
  "clock": 454,
  "match": 1.0,
  "start": 454.0,
  "end": 455.85
 },
 {
  "id": "P6.06",
  "part": "P6",
  "text": "The staff and suppliers still had to be paid.",
  "words": 9,
  "scene": "09",
  "clock": 454,
  "match": 1.0,
  "start": 455.85,
  "end": 460.0
 },
 {
  "id": "P6.07",
  "part": "P6",
  "text": "Public funding changed who faced the bill.",
  "words": 7,
  "scene": "09",
  "clock": 460,
  "match": 1.0,
  "start": 460.0,
  "end": 466.0
 },
 {
  "id": "P6.08",
  "part": "P6",
  "text": "A nurse could get on with the work.",
  "words": 8,
  "scene": "09",
  "clock": 466,
  "match": 1.0,
  "start": 466.0,
  "end": 471.0
 },
 {
  "id": "P6.09",
  "part": "P6",
  "text": "A patient could get on with getting better.",
  "words": 8,
  "scene": "09",
  "clock": 471,
  "match": 1.0,
  "start": 471.0,
  "end": 480.0
 },
 {
  "id": "P6.10",
  "part": "P6",
  "text": "Councils commissioned homes. Builders built them. Families moved in.",
  "words": 9,
  "scene": "10",
  "clock": 480,
  "match": 0.59,
  "start": 480.0,
  "end": 491.0
 },
 {
  "id": "P6.11",
  "part": "P6",
  "text": "Not everyone got a home. Not overnight.",
  "words": 7,
  "scene": "10",
  "clock": 491,
  "match": 1.0,
  "start": 491.0,
  "end": 495.45
 },
 {
  "id": "P6.12",
  "part": "P6",
  "text": "But the building continued.",
  "words": 4,
  "scene": "10",
  "clock": 491,
  "match": 1.0,
  "start": 495.45,
  "end": 498.0
 },
 {
  "id": "P6.13",
  "part": "P6",
  "text": "Under the Conservatives, Harold Macmillan made housing a major priority too.",
  "words": 11,
  "scene": "10",
  "clock": 498,
  "match": 1.0,
  "start": 498.0,
  "end": 503.0
 },
 {
  "id": "P6.14",
  "part": "P6",
  "text": "They disagreed about plenty.",
  "words": 4,
  "scene": "10",
  "clock": 503,
  "match": 1.0,
  "start": 503.0,
  "end": 505.0
 },
 {
  "id": "P6.15",
  "part": "P6",
  "text": "Large-scale council building wasn't confined to one party.",
  "words": 8,
  "scene": "10",
  "clock": 503,
  "match": 1.0,
  "start": 505.0,
  "end": 509.0
 },
 {
  "id": "P6.16",
  "part": "P6",
  "text": "A key in a front door is a fairly practical sort of patriotism.",
  "words": 13,
  "scene": "10",
  "clock": 509,
  "match": 1.0,
  "start": 509.0,
  "end": 515.0
 },
 {
  "id": "P6.17",
  "part": "P6",
  "text": "And the debt?",
  "words": 3,
  "scene": "10b",
  "clock": 515,
  "match": 1.0,
  "start": 515.0,
  "end": 516.29
 },
 {
  "id": "P6.18",
  "part": "P6",
  "text": "It was never cleared.",
  "words": 4,
  "scene": "10b",
  "clock": 515,
  "match": 1.0,
  "start": 516.29,
  "end": 518.0
 },
 {
  "id": "P6.19",
  "part": "P6",
  "text": "In pounds, it never went away. It ended bigger.",
  "words": 9,
  "scene": "10b",
  "clock": 518,
  "match": 0.56,
  "start": 518.0,
  "end": 521.0
 },
 {
  "id": "P6.20",
  "part": "P6",
  "text": "The economy rose faster.",
  "words": 4,
  "scene": "10b",
  "clock": 521,
  "match": 1.0,
  "start": 521.0,
  "end": 524.0
 },
 {
  "id": "P6.21",
  "part": "P6",
  "text": "People were housed, treated, and in work.",
  "words": 7,
  "scene": "10b",
  "clock": 524,
  "match": 1.0,
  "start": 524.0,
  "end": 530.0
 },
 {
  "id": "P6.22",
  "part": "P6",
  "text": "For twenty years, registered unemployment averaged under two in a hundred.",
  "words": 11,
  "scene": "10b",
  "clock": 530,
  "match": 0.92,
  "start": 530.0,
  "end": 535.0
 },
 {
  "id": "P6.23",
  "part": "P6",
  "text": "For twenty-seven years running, the debt shrank against the size of the country.",
  "words": 13,
  "scene": "10b",
  "clock": 535,
  "match": 1.0,
  "start": 535.0,
  "end": 541.0
 },
 {
  "id": "P6.24",
  "part": "P6",
  "text": "Not by magic.",
  "words": 3,
  "scene": "10b",
  "clock": 541,
  "match": 1.0,
  "start": 541.0,
  "end": 543.0
 },
 {
  "id": "P6.25",
  "part": "P6",
  "text": "Budgets were tight.",
  "words": 3,
  "scene": "10b",
  "clock": 541,
  "match": 1.0,
  "start": 543.0,
  "end": 545.0
 },
 {
  "id": "P6.26",
  "part": "P6",
  "text": "Interest was held below inflation, so lenders and savers carried part of the bill.",
  "words": 14,
  "scene": "10b",
  "clock": 545,
  "match": 1.0,
  "start": 545.0,
  "end": 551.53
 },
 {
  "id": "P6.27",
  "part": "P6",
  "text": "Quietly.",
  "words": 1,
  "scene": "10b",
  "clock": 545,
  "match": 1.0,
  "start": 551.53,
  "end": 552.0
 },
 {
  "id": "P6.28",
  "part": "P6",
  "text": "Britain did not shrink to fit its debt.",
  "words": 8,
  "scene": "10b",
  "clock": 552,
  "match": 1.0,
  "start": 552.0,
  "end": 557.82
 },
 {
  "id": "P6.29",
  "part": "P6",
  "text": "It outgrew it.",
  "words": 3,
  "scene": "10b",
  "clock": 552,
  "match": 1.0,
  "start": 557.82,
  "end": 560.0
 },
 {
  "id": "P7.01",
  "part": "P7",
  "text": "Two thousand and eight.",
  "words": 4,
  "scene": "10a",
  "clock": 560,
  "match": 1.0,
  "start": 560.0,
  "end": 561.78
 },
 {
  "id": "P7.02",
  "part": "P7",
  "text": "The banking system is failing.",
  "words": 5,
  "scene": "10a",
  "clock": 560,
  "match": 1.0,
  "start": 561.78,
  "end": 564.0
 },
 {
  "id": "P7.03",
  "part": "P7",
  "text": "Government buys bank shares, makes loans, and gives guarantees to keep it standing.",
  "words": 13,
  "scene": "10a",
  "clock": 564,
  "match": 1.0,
  "start": 564.0,
  "end": 570.0
 },
 {
  "id": "P7.04",
  "part": "P7",
  "text": "In March two thousand and nine, the Bank of England does something else.",
  "words": 13,
  "scene": "10a",
  "clock": 570,
  "match": 0.8,
  "start": 570.0,
  "end": 574.0
 },
 {
  "id": "P7.05",
  "part": "P7",
  "text": "It creates new money, electronically, and uses it to buy bonds.",
  "words": 11,
  "scene": "10a",
  "clock": 574,
  "match": 1.0,
  "start": 574.0,
  "end": 581.0
 },
 {
  "id": "P7.06",
  "part": "P7",
  "text": "This is new money. The Bank says so itself.",
  "words": 9,
  "scene": "10a",
  "clock": 581,
  "match": 1.0,
  "start": 581.0,
  "end": 586.0
 },
 {
  "id": "P7.07",
  "part": "P7",
  "text": "Most money, in fact, is made by ordinary banks when they lend.",
  "words": 12,
  "scene": "10a",
  "clock": 586,
  "match": 1.0,
  "start": 586.0,
  "end": 590.42
 },
 {
  "id": "P7.08",
  "part": "P7",
  "text": "There was never a fixed national pot.",
  "words": 7,
  "scene": "10a",
  "clock": 586,
  "match": 1.0,
  "start": 590.42,
  "end": 593.0
 },
 {
  "id": "P7.09",
  "part": "P7",
  "text": "The Bank's new money probably prevented a worse slump.",
  "words": 9,
  "scene": "10a",
  "clock": 593,
  "match": 1.0,
  "start": 593.0,
  "end": 598.0
 },
 {
  "id": "P7.10",
  "part": "P7",
  "text": "It also lifted the price of things people already owned.",
  "words": 10,
  "scene": "10a",
  "clock": 598,
  "match": 1.0,
  "start": 598.0,
  "end": 605.0
 },
 {
  "id": "P7.11",
  "part": "P7",
  "text": "Good news... if you owned some.",
  "words": 6,
  "scene": "10a",
  "clock": 605,
  "match": 1.0,
  "start": 605.0,
  "end": 615.0
 },
 {
  "id": "P7.12",
  "part": "P7",
  "text": "Twenty ten.",
  "words": 2,
  "scene": "11",
  "clock": 615,
  "match": 1.0,
  "start": 615.0,
  "end": 616.33
 },
 {
  "id": "P7.13",
  "part": "P7",
  "text": "Borrowing is very high.",
  "words": 4,
  "scene": "11",
  "clock": 615,
  "match": 1.0,
  "start": 616.33,
  "end": 619.0
 },
 {
  "id": "P7.14",
  "part": "P7",
  "text": "The case for cutting is one every household understands...",
  "words": 9,
  "scene": "11",
  "clock": 619,
  "match": 1.0,
  "start": 619.0,
  "end": 623.24
 },
 {
  "id": "P7.15",
  "part": "P7",
  "text": "you can't keep spending money you haven't got.",
  "words": 8,
  "scene": "11",
  "clock": 619,
  "match": 1.0,
  "start": 623.24,
  "end": 627.0
 },
 {
  "id": "P7.16",
  "part": "P7",
  "text": "The Coalition chooses tax rises and spending restraint.",
  "words": 8,
  "scene": "11",
  "clock": 627,
  "match": 1.0,
  "start": 627.0,
  "end": 631.0
 },
 {
  "id": "P7.17",
  "part": "P7",
  "text": "Mostly restraint.",
  "words": 2,
  "scene": "11",
  "clock": 627,
  "match": 1.0,
  "start": 631.0,
  "end": 632.0
 },
 {
  "id": "P7.18",
  "part": "P7",
  "text": "Public-sector pay is frozen for two years, then held to about one per cent.",
  "words": 14,
  "scene": "11",
  "clock": 632,
  "match": 1.0,
  "start": 632.0,
  "end": 638.0
 },
 {
  "id": "P7.19",
  "part": "P7",
  "text": "So the Bank is creating money while the Treasury is holding it back.",
  "words": 13,
  "scene": "11",
  "clock": 638,
  "match": 1.0,
  "start": 638.0,
  "end": 643.35
 },
 {
  "id": "P7.20",
  "part": "P7",
  "text": "Same country. Same years.",
  "words": 4,
  "scene": "11",
  "clock": 638,
  "match": 1.0,
  "start": 643.35,
  "end": 645.0
 },
 {
  "id": "P7.21",
  "part": "P7",
  "text": "Twenty seventeen. Question Time.",
  "words": 4,
  "scene": "11",
  "clock": 645,
  "match": 1.0,
  "start": 645.0,
  "end": 646.82
 },
 {
  "id": "P7.22",
  "part": "P7",
  "text": "Nurses ask the Prime Minister about pay.",
  "words": 7,
  "scene": "11",
  "clock": 645,
  "match": 1.0,
  "start": 646.82,
  "end": 650.0
 },
 {
  "id": "P7.23",
  "part": "P7",
  "text": "One says her payslip matches the one she had in two thousand and nine.",
  "words": 14,
  "scene": "11",
  "clock": 650,
  "match": 0.79,
  "start": 650.0,
  "end": 656.0
 },
 {
  "id": "P7.24",
  "part": "P7",
  "text": "Theresa May says she recognises the job they do.",
  "words": 9,
  "scene": "11",
  "clock": 656,
  "match": 1.0,
  "start": 656.0,
  "end": 662.0
 },
 {
  "id": "P7.25",
  "part": "P7",
  "text": "Then she says there isn't a magic money tree that we can shake.",
  "words": 13,
  "scene": "11",
  "clock": 662,
  "match": 1.0,
  "start": 662.0,
  "end": 668.0
 },
 {
  "id": "P7.26",
  "part": "P7",
  "text": "You can print the money.",
  "words": 5,
  "scene": "11",
  "clock": 668,
  "match": 1.0,
  "start": 668.0,
  "end": 672.0
 },
 {
  "id": "P7.27",
  "part": "P7",
  "text": "You can't print the nurse.",
  "words": 5,
  "scene": "11",
  "clock": 672,
  "match": 1.0,
  "start": 672.0,
  "end": 679.22
 },
 {
  "id": "P7.28",
  "part": "P7",
  "text": "She was already there.",
  "words": 4,
  "scene": "11",
  "clock": 672,
  "match": 1.0,
  "start": 679.22,
  "end": 685.0
 },
 {
  "id": "P8.01",
  "part": "P8",
  "text": "Twenty twenty. Covid.",
  "words": 3,
  "scene": "11a",
  "clock": 685,
  "match": 1.0,
  "start": 685.0,
  "end": 686.88
 },
 {
  "id": "P8.02",
  "part": "P8",
  "text": "Money is found. In days.",
  "words": 5,
  "scene": "11a",
  "clock": 685,
  "match": 1.0,
  "start": 686.88,
  "end": 690.0
 },
 {
  "id": "P8.03",
  "part": "P8",
  "text": "The Treasury borrows hundreds of billions.",
  "words": 6,
  "scene": "11a",
  "clock": 690,
  "match": 1.0,
  "start": 690.0,
  "end": 692.77
 },
 {
  "id": "P8.04",
  "part": "P8",
  "text": "The Bank creates hundreds of billions more.",
  "words": 7,
  "scene": "11a",
  "clock": 690,
  "match": 1.0,
  "start": 692.77,
  "end": 696.0
 },
 {
  "id": "P8.05",
  "part": "P8",
  "text": "Some of what government spends keeps wages paid.",
  "words": 8,
  "scene": "11a",
  "clock": 696,
  "match": 1.0,
  "start": 696.0,
  "end": 700.0
 },
 {
  "id": "P8.06",
  "part": "P8",
  "text": "That part is planted.",
  "words": 4,
  "scene": "11a",
  "clock": 696,
  "match": 1.0,
  "start": 700.0,
  "end": 702.0
 },
 {
  "id": "P8.07",
  "part": "P8",
  "text": "Some goes down a priority lane, for suppliers recommended by ministers, MPs and peers.",
  "words": 14,
  "scene": "11a",
  "clock": 702,
  "match": 1.0,
  "start": 702.0,
  "end": 710.0
 },
 {
  "id": "P8.08",
  "part": "P8",
  "text": "One company is a few weeks old.",
  "words": 7,
  "scene": "11a",
  "clock": 710,
  "match": 1.0,
  "start": 710.0,
  "end": 713.29
 },
 {
  "id": "P8.09",
  "part": "P8",
  "text": "It wins contracts worth two hundred and three million pounds.",
  "words": 10,
  "scene": "11a",
  "clock": 710,
  "match": 1.0,
  "start": 713.29,
  "end": 718.0
 },
 {
  "id": "P8.10",
  "part": "P8",
  "text": "The gowns are rejected... not sterile, as the contract required.",
  "words": 10,
  "scene": "11a",
  "clock": 718,
  "match": "slot",
  "start": 718.0,
  "end": 721.0
 },
 {
  "id": "P8.11",
  "part": "P8",
  "text": "A court orders the company to repay a hundred and twenty-two million.",
  "words": 12,
  "scene": "11a",
  "clock": 721,
  "match": 0.77,
  "start": 721.0,
  "end": 727.0
 },
 {
  "id": "P8.12",
  "part": "P8",
  "text": "The company goes into administration the day before the judgment.",
  "words": 10,
  "scene": "11a",
  "clock": 727,
  "match": 1.0,
  "start": 727.0,
  "end": 732.0
 },
 {
  "id": "P8.13",
  "part": "P8",
  "text": "In May twenty twenty, according to emails reported by the Guardian, Baroness Mone told the government she would not benefit.",
  "words": 20,
  "scene": "11a",
  "clock": 732,
  "match": 0.64,
  "start": 732.0,
  "end": 737.0
 },
 {
  "id": "P8.14",
  "part": "P8",
  "text": "She later said on television that she is a beneficiary of family trusts holding about sixty million.",
  "words": 17,
  "scene": "11a",
  "clock": 737,
  "match": 0.79,
  "start": 737.0,
