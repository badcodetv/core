     "t": 67.12,
     "dur": 2.84
    }
   ],
   "dur": 9.96
  },
  {
   "id": "6",
   "title": "The debate",
   "start": 70.66,
   "see": "Sandra: she'd take any way out, and grumpy Derek. The old lady: food; perhaps a vote. No vote shown.",
   "act": "The bridge",
   "lines": [
    {
     "i": 16,
     "who": "woman",
     "name": "Sandra",
     "text": "If there's a way to fix this, I'd love to take it. It sucks living in this bunker with grumpy Derek.",
