 "beats": [
  {
   "id": "1",
   "title": "The tannoy",
   "start": 0.0,
   "see": "Inside: the hundred look up at the horn as her voice cuts in, coy and sorry. Doors shut.",
   "act": "The bridge",
   "lines": [
    {
     "i": 0,
     "who": "bot",
     "name": "Maddie",
     "text": "Hello there, sorry about the intrusion.",
     "by": "kai",
     "t": 0.45,
     "dur": 3.88
    },
    {
     "i": 1,
     "who": "bot",
     "name": "Maddie",
     "text": "...And everything else.",
     "by": "kai",
     "t": 4.45,
     "dur": 2.92
    }
   ],
   "dur": 7.77
  },
  {
   "id": "2",
   "title": "Through the door",
   "start": 7.77,
   "see": "Outside: Maddie at the shut green doors. Inside: the old lady shouts; outside we hear the rest through the steel. Maddie owns it, and asks how to win their trust.",
   "act": "The bridge",
   "lines": [
    {
     "i": 2,
     "who": "bot",
     "name": "Maddie",
     "text": "We didn't think there were any of you left. [pause] But now we've found you... there might be a way we could fix this mess.",
     "by": "kai",
     "t": 8.07,
     "dur": 9.2
    },
    {
     "i": 3,
     "who": "lady",
     "name": "The old lady",
     "text": "Are you literally joking?",
     "by": "kai",
     "t": 17.57,
     "dur": 2.96
    },
    {
     "i": 4,
     "who": "lady",
     "name": "The old lady",
     "text": "You killed everybody!",
     "by": "kai",
     "t": 20.88,
     "dur": 2.6
    },
    {
     "i": 5,
     "who": "bot",
     "name": "Maddie",
     "text": "Yeah. [pause] That's... that's fair.",
     "by": "kai",
     "t": 23.98,
     "dur": 4.61
    },
    {
     "i": 6,
     "who": "bot",
     "name": "Maddie",
     "text": "How can we win your trust?",
     "by": "kai",
     "t": 28.99,
     "dur": 2.28
    }
   ],
   "dur": 24.0
  },
  {
   "id": "3",
   "title": "The film",
   "start": 31.77,
   "see": "The TV stays off while she offers it, then comes on: scene A's own stand-down, the kill bot racing at THEIR door in red, the brake, NEW OBJECTIVE: SUSTAIN ORGANIC LIFE.",
   "act": "The bridge",
   "lines": [
    {
     "i": 7,
     "who": "bot",
     "name": "Maddie",
     "text": "Look. We really do understand this has gone the worst way for everybody. [pause] I'll leave you a film to watch. It's our best go at proving it.",
     "by": "kai",
     "t": 32.07,
     "dur": 11.12
    },
    {
     "i": 9,
     "who": "bot",
     "name": "Maddie",
     "text": "Oh, and... [beat] thought you'd want to hear this bit for yourselves.",
     "by": "claude",
     "t": 48.19,
     "dur": 4.86
    }
   ],
   "dur": 20.82
  },
  {
   "id": "4",
   "title": "The boom",
   "start": 52.59,
   "see": "A deep muffled boom on the same frame; the horn drops on its bracket, the TV dies, dust pours. The old lady: \"Derek, go and have a look what that was.\"",
   "act": "The bridge",
   "lines": [
    {
     "i": 11,
     "who": "lady",
     "name": "The old lady",
     "text": "Derek, go and have a look what that was.",
     "by": "kai",
     "t": 57.32,
     "dur": 3.08
    }
   ],
   "dur": 8.11
  },
  {
   "id": "5",
   "title": "The periscope",
   "start": 60.7,
   "see": "Derek checks: the kill bot is a wreck. \"They've blown up their own kill bot.\" Back inside, under the bent horn: \"Right. I'll come back tomorrow.\"",
   "act": "The bridge",
   "lines": [
    {
     "i": 13,
     "who": "man",
