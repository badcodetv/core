 "lines": [
  {
   "start": 1.34,
   "end": 5.92,
   "text": "🎶 Music 🎶",
   "start_snapped": 1.335
  },
  {
   "start": 7.8,
   "end": 8.4,
   "text": "Robbery!",
   "start_snapped": 7.941
  },
  {
   "start": 13.42,
   "end": 17.4,
   "text": "🎶 Music 🎶",
   "start_snapped": 13.711
  },
  {
   "start": 18.0,
   "end": 20.14,
   "text": "Dah, dah, dah, dah",
   "start_snapped": 17.914
  },
  {
   "start": 20.14,
   "end": 22.84,
   "text": "They say, you can't make money from a tree",
   "start_snapped": 20.178
  },
  {
   "start": 22.84,
   "end": 25.26,
   "text": "Let's see each day, make hay not free",
   "start_snapped": 22.756
  },
  {
   "start": 25.26,
   "end": 27.1,
   "text": "Ayy, work can get paid though",
   "start_snapped": 25.356
  },
  {
   "start": 27.1,
   "end": 29.52,
   "text": "Earning that dough, but where does it go?",
   "start_snapped": 26.947
  },
  {
   "start": 29.52,
   "end": 31.0,
   "text": "Nobody knows!",
   "start_snapped": 29.187
  },
  {
   "start": 31.3,
   "end": 33.34,
   "text": "Means of production, means of reduction",
   "start_snapped": 31.161
  },
  {
   "start": 33.34,
   "end": 35.92,
   "text": "Standards bleeding, landlords needing",
   "start_snapped": 33.413
  },
  {
   "start": 35.92,
   "end": 38.68,
   "text": "Quantitive easing, grandma freezing",
   "start_snapped": 35.968
  },
  {
   "start": 38.68,
   "end": 41.2,
   "text": "Simulus checks and necks get wrecked",
   "start_snapped": 38.556
  },
  {
   "start": 41.2,
   "end": 43.72,
   "text": "Rent seeking, I'm just about eating",
   "start_snapped": 41.111
  },
  {
   "start": 43.72,
   "end": 46.28,
   "text": "Sorry, did I interrupt your meeting?",
   "start_snapped": 43.386
  },
  {
   "start": 46.46,
   "end": 48.68,
   "text": "Remember kids, the Fed is not your friend",
   "start_snapped": 46.312
  },
  {
   "start": 48.68,
   "end": 51.66,
   "text": "It prints all the dollars that the government spends",
   "start_snapped": 48.576
  },
  {
   "start": 51.66,
   "end": 55.3,
   "text": "It's fiat system is insistent on debts existence",
   "start_snapped": 51.78
  },
  {
   "start": 55.3,
   "end": 59.48,
   "text": "Oh, oh, oh",
   "start_snapped": 55.24
  },
  {
   "start": 59.48,
   "end": 61.86,
   "text": "Have resistance to the facts I'm stating",
   "start_snapped": 59.536
  },
  {
   "start": 61.86,
   "end": 63.92,
   "text": "Robbery! Robbery!",
   "start_snapped": 61.753
  },
  {
   "start": 64.6,
   "end": 66.46,
   "text": "Call the police, it's a robbery",
   "start_snapped": 64.714
  },
  {
   "start": 67.04,
   "end": 68.38,
   "text": "Debasement, debasement",
   "start_snapped": 66.966
  },
  {
   "start": 68.38,
   "end": 69.6,
   "text": "It happened in the basement",
   "start_snapped": 68.255
  },
  {
   "start": 69.6,
   "end": 72.26,
   "text": "Printer is burring, now now what's a burring?",
   "start_snapped": 69.532
  },
  {
   "start": 72.52,
   "end": 73.56,
   "text": "Robbery! Robbery!",
   "start_snapped": 72.423
  },
  {
   "start": 74.32,
   "end": 76.78,
   "text": "Call the police, it's a robbery",
   "start_snapped": 74.374
  },
  {
   "start": 77.36,
   "end": 78.7,
   "text": "Debasement, debasement",
   "start_snapped": 77.276
  },
  {
   "start": 78.7,
   "end": 79.98,
   "text": "It happened in the basement",
   "start_snapped": 78.576
  },
  {
   "start": 79.98,
   "end": 82.5,
   "text": "Printer is burring, now now what's a burring?",
   "start_snapped": 79.841
  },
  {
   "start": 82.76,
   "end": 84.48,
   "text": "Stacks and stacks of elastic cash",
   "start_snapped": 82.977
  },
  {
   "start": 85.14,
   "end": 87.8,
   "text": "Distracted by a dyspraxic flash",
   "start_snapped": 85.008
  },
  {
   "start": 87.8,
   "end": 90.06,
   "text": "Marked angry at the shitty little drop",
   "start_snapped": 87.934
  },
  {
   "start": 90.06,
   "end": 92.78,
   "text": "The right and the left both witness the theft",
   "start_snapped": 90.384
  },
  {
   "start": 92.78,
   "end": 95.26,
   "text": "Blaming each other is a sick little cover",
   "start_snapped": 92.764
  },
  {
   "start": 95.26,
   "end": 97.52,
   "text": "Institutional, dilutional, the usual",
   "start_snapped": 95.016
  },
  {
   "start": 98.7,
   "end": 100.4,
   "text": "Distraction is the attraction",
   "start_snapped": 98.558
  },
  {
   "start": 100.4,
   "end": 101.88,
   "text": "The intention is tension",
   "start_snapped": 100.496
  },
  {
   "start": 101.88,
   "end": 104.38,
   "text": "Between the factions, divide and conquer",
   "start_snapped": 102.005
  },
  {
   "start": 104.38,
   "end": 105.36,
   "text": "Just look at the hand",
   "start_snapped": 104.339
  },
  {
   "start": 105.36,
   "end": 106.8,
   "text": "It's not your standard propaganda",
   "start_snapped": 105.326
  },
  {
   "start": 106.8,
   "end": 108.24,
   "text": "Worth a couple grand, ah!",
   "start_snapped": 106.626
  },
  {
   "start": 108.42,
   "end": 110.54,
   "text": "It is state level manipulation",
   "start_snapped": 108.263
  },
  {
   "start": 110.54,
   "end": 113.46,
   "text": "It is the devil with the radio station",
   "start_snapped": 110.504
  },
  {
   "start": 113.46,
   "end": 115.76,
   "text": "Stack up the vaults like a wheelbarrow",
   "start_snapped": 113.406
  },
  {
   "start": 115.76,
   "end": 118.46,
   "text": "Risk of default is really rather narrow",
   "start_snapped": 115.647
  },
  {
   "start": 118.46,
   "end": 120.0,
   "text": "Biggie said, wait!",
   "start_snapped": 118.561
  },
  {
   "start": 120.2,
   "end": 121.16,
   "text": "Rockin' 97",
   "start_snapped": 120.186
  },
  {
   "start": 121.16,
   "end": 123.74,
   "text": "Don't get high off your own supply",
   "start_snapped": 121.452
  },
  {
   "start": 123.74,
   "end": 125.84,
   "text": "Robbery! Robbery!",
   "start_snapped": 123.716
  },
  {
   "start": 126.48,
   "end": 128.38,
   "text": "Call the police, it's a robbery",
   "start_snapped": 126.642
  },
  {
   "start": 129.0,
   "end": 130.3,
   "text": "Debasement, debasement",
   "start_snapped": 128.894
  },
  {
   "start": 130.3,
   "end": 131.62,
   "text": "It happened in the basement",
   "start_snapped": 130.183
  },
  {
   "start": 131.62,
   "end": 134.26,
   "text": "Printer is burring, now now what's a burring?",
   "start_snapped": 131.471
  },
  {
   "start": 134.44,
   "end": 136.1,
   "text": "Robbery! Robbery!",
   "start_snapped": 134.374
  },
  {
   "start": 136.46,
   "end": 138.74,
   "text": "Call the police, it's a robbery",
   "start_snapped": 136.301
  },
  {
   "start": 139.3,
   "end": 140.64,
   "text": "Debasement, debasement",
   "start_snapped": 139.215
  },
  {
   "start": 140.64,
   "end": 141.94,
   "text": "It happened in the basement",
   "start_snapped": 140.504
  },
  {
   "start": 141.94,
   "end": 144.18,
   "text": "Printer is burring, now now what's a burring?",
   "start_snapped": 141.793
  },
  {
   "start": 144.18,
   "end": 146.62,
   "text": "You know the real star is Pablo Escobar",
   "start_snapped": 144.033
  },
  {
   "start": 146.62,
   "end": 149.66,
   "text": "Who has elastic bands, not plastic hands",
   "start_snapped": 146.634
  },
  {
   "start": 149.66,
   "end": 152.1,
   "text": "Stackin' up the cash by the grand",
   "start_snapped": 149.722
  },
  {
   "start": 152.1,
   "end": 154.18,
   "text": "Stand up plans are for the working man",
   "start_snapped": 152.114
  },
  {
   "start": 154.74,
   "end": 157.04,
   "text": "And this right here is a next level scam",
   "start_snapped": 154.691
  },
  {
   "start": 157.04,
   "end": 159.84,
   "text": "All gotten gains, no need to explain",
   "start_snapped": 156.944
  },
  {
   "start": 159.84,
   "end": 162.54,
   "text": "Bailin' out will never mean the same",
   "start_snapped": 159.521
  },
  {
   "start": 162.54,
   "end": 164.92,
   "text": "Own a printer and you don't feel winter",
   "start_snapped": 162.435
  },
  {
   "start": 164.92,
   "end": 167.64,
   "text": "Crime is asset inflation, passive creation",
   "start_snapped": 165.024
  },
  {
   "start": 167.64,
   "end": 170.08,
   "text": "Of a wealth gap that drives the situation",
   "start_snapped": 167.602
  },
  {
   "start": 170.08,
   "end": 171.68,
   "text": "Rockin' people get paid in money",
   "start_snapped": 170.179
  },
  {
   "start": 171.68,
   "end": 173.94,
   "text": "So it's not very funny when you print more",
   "start_snapped": 171.781
  },
  {
   "start": 173.94,
   "end": 175.36,
   "text": "And expect them not to worry",
   "start_snapped": 174.057
  },
  {
   "start": 175.94,
   "end": 177.98,
   "text": "Hungry people feed a revolution",
   "start_snapped": 175.984
  },
  {
   "start": 177.98,
   "end": 179.94,
   "text": "Then it's retribution, perhaps some execution",
   "start_snapped": 177.935
  },
  {
   "start": 180.52,
   "end": 183.26,
   "text": "It's time to give, not just to take",
   "start_snapped": 180.547
  },
  {
   "start": 183.26,
   "end": 184.62,
   "text": "But for heaven's sake",
   "start_snapped": 183.542
  },
  {
   "start": 184.62,
   "end": 187.0,
   "text": "Don't just eat cake",
   "start_snapped": 184.599
  }
 ],
