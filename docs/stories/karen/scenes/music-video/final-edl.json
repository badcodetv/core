     "i": 1,
     "who": "karen",
     "name": "Karen",
     "t": 35.3,
     "dur": 2.9,
     "text": "thirty years of service and one simple ask.",
     "by": "kai"
    },
    {
     "i": 2,
     "who": "clerk",
     "name": "Clerk",
     "t": 38.2,
     "dur": 3.9,
     "text": "(Ma'am, I'm only the front desk, I can't authorise that)",
     "by": "kai"
    },
    {
     "i": 3,
     "who": "karen",
     "name": "Karen",
     "t": 42.1,
     "dur": 3.8,
     "text": "Then fetch me the desk that sits behind the desk you sat at.",
     "by": "kai"
    },
    {
     "i": 4,
     "who": "clerk",
     "name": "Clerk",
     "t": 45.9,
     "dur": 4.1,
     "text": "(My supervisor's in a meeting, she's not free until three)",
     "by": "kai"
    },
    {
     "i": 5,
     "who": "karen",
     "name": "Karen",
     "t": 50.0,
     "dur": 5.5,
     "text": "Three's fine. I'm free at three. Three is lo-o-ovely to me.",
     "by": "kai"
    },
    {
     "i": 6,
     "who": "clerk",
     "name": "Clerk",
     "t": 55.5,
     "dur": 3.0,
     "text": "(There's really nothing further I can do at this level)",
     "by": "kai"
    },
